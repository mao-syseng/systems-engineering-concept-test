---
import { Image } from "astro:assets"
import heroImage from "@/assets/hero.png"
import HeroButtons from "@/components/ui/hero-buttons"
---

<section class="relative min-h-screen overflow-hidden bg-background">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center min-h-screen py-12">
      {/* Content */}
      <div class="flex flex-col justify-center space-y-8">
        <div>
          <h1 class="text-5xl sm:text-6xl font-bold tracking-tight mb-6">
            We believe in, think and work with systems engineering
          </h1>
          <p class="text-xl text-muted-foreground leading-relaxed mb-8">
            Implement the Systems Engineering Concept into your organization,
            and you have solid laid-out methods which give hands-on instructions
            from the first to the final stages. <a
              href="https://systemsengineeringconcept.com/concept"
              class="text-foreground underline underline-offset-4"
              >Read more about the Systems Engineering Concept</a
            >
          </p>
        </div>

        <HeroButtons />
      </div>

      {/* Image */}
      <div class="relative flex items-center justify-center">
        <div class="relative w-full">
          <Image
            src={heroImage}
            alt="SEC-Hub systems engineering platform"
            class="w-full h-auto rounded-lg"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>
